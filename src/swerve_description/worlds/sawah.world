<?xml version="1.0"?>
<!--
  sawah.world - Simulasi Petak Sawah untuk Robot Padi
  Gazebo Harmonic (ROS 2 Jazzy)
  
  Berisi:
  - Tanah sawah berstruktur lumpur (friction rendah)
  - Barisan tanaman padi (collision cylinder)
  - Pencahayaan siang hari
  - Physics tuning untuk kondisi sawah
-->
<sdf version="1.9">
  <world name="sawah">

    <!-- Physics -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <!-- Plugin -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- Cahaya matahari -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.85 0.7 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
    </light>

    <!-- Tanah sawah (permukaan basah/licin) -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane><normal>0 0 1</normal><size>30 20</size></plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <!-- Lumpur sawah: friction rendah -->
                <mu>0.4</mu>
                <mu2>0.4</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane><normal>0 0 1</normal><size>30 20</size></plane>
          </geometry>
          <material>
            <ambient>0.35 0.28 0.15 1</ambient>
            <diffuse>0.40 0.32 0.18 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ════ BARISAN TANAMAN PADI ════════════════════════════════
         Jarak antar tanaman: 0.25m x 0.25m
         Area: 10m x 5m
         Total tanaman: 40 x 20 = 800 (disederhanakan dengan macro)
    -->

    <!-- Macro tanaman padi (cylinder hijau) -->
    <!-- Karena SDF tidak punya macro built-in, kita buat beberapa baris representatif -->
    <!-- Baris 1: y=0.25 -->
    <model name="padi_row_0">
      <static>true</static>
      <pose>5 0.25 0 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><cylinder><radius>0.04</radius><length>0.40</length></cylinder></geometry>
          <material><ambient>0.1 0.6 0.1 1</ambient><diffuse>0.15 0.7 0.15 1</diffuse></material>
        </visual>
        <collision name="collision">
          <geometry><cylinder><radius>0.04</radius><length>0.40</length></cylinder></geometry>
        </collision>
        <pose>0 0 0.20 0 0 0</pose>
      </link>
    </model>

    <!-- Kita buat 5 baris tipikal untuk simulasi -->
    <model name="padi_row_1">
      <static>true</static>
      <pose>5 0.50 0 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><cylinder><radius>0.04</radius><length>0.40</length></cylinder></geometry>
          <material><ambient>0.1 0.6 0.1 1</ambient><diffuse>0.15 0.7 0.15 1</diffuse></material>
        </visual>
        <collision name="col"><geometry><cylinder><radius>0.04</radius><length>0.40</length></cylinder></geometry></collision>
        <pose>0 0 0.20 0 0 0</pose>
      </link>
    </model>

    <model name="padi_row_2">
      <static>true</static>
      <pose>5 0.75 0 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><cylinder><radius>0.04</radius><length>0.40</length></cylinder></geometry>
          <material><ambient>0.1 0.6 0.1 1</ambient><diffuse>0.15 0.7 0.15 1</diffuse></material>
        </visual>
        <collision name="col"><geometry><cylinder><radius>0.04</radius><length>0.40</length></cylinder></geometry></collision>
        <pose>0 0 0.20 0 0 0</pose>
      </link>
    </model>

    <model name="padi_row_3">
      <static>true</static>
      <pose>5 1.00 0 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><cylinder><radius>0.04</radius><length>0.40</length></cylinder></geometry>
          <material><ambient>0.1 0.6 0.1 1</ambient><diffuse>0.15 0.7 0.15 1</diffuse></material>
        </visual>
        <collision name="col"><geometry><cylinder><radius>0.04</radius><length>0.40</length></cylinder></geometry></collision>
        <pose>0 0 0.20 0 0 0</pose>
      </link>
    </model>

    <!-- Pembatas area sawah (pematang) -->
    <model name="pematang_utara">
      <static>true</static>
      <pose>5 5.5 0 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>12 0.3 0.15</size></geometry>
          <material><ambient>0.4 0.3 0.1 1</ambient></material>
        </visual>
        <collision name="col">
          <geometry><box><size>12 0.3 0.15</size></geometry>
        </collision>
        <pose>0 0 0.075 0 0 0</pose>
      </link>
    </model>

    <model name="pematang_selatan">
      <static>true</static>
      <pose>5 -0.5 0 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>12 0.3 0.15</size></geometry>
          <material><ambient>0.4 0.3 0.1 1</ambient></material>
        </visual>
        <collision name="col">
          <geometry><box><size>12 0.3 0.15</size></geometry>
        </collision>
        <pose>0 0 0.075 0 0 0</pose>
      </link>
    </model>

  </world>
</sdf>
